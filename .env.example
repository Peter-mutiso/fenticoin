# Copy this file to `.env` in the same directory (repo root, for local
# multi-app dev) or into each app's own directory, and fill in real values.
# Never commit the resulting `.env` file — it is gitignored on purpose.

# ---- apps/api ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Postgres connection string. For local dev, run a Postgres container, e.g.:
#   docker compose up -d postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fenticoin

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=info

# Public base URL of the frontend — used to build links sent to users
# (email verification, password reset, OAuth redirects).
APP_BASE_URL=http://localhost:3000

# Signs access tokens and short-lived internal challenge tokens (e.g. the
# "password verified, now provide your 2FA code" step). Generate with:
#   openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# AES-256-GCM key used only to encrypt 2FA TOTP secrets at rest. Exactly 32
# bytes, hex-encoded. Generate with: openssl rand -hex 32
# Rotating this key invalidates existing 2FA enrollments.
ENCRYPTION_KEY=

# --- Optional external providers ---------------------------------------
# Each provider group is all-or-nothing: set every variable in the group or
# leave the whole group unset. Unset = the corresponding auth endpoints
# respond with a clear "not configured" error rather than silently no-op'ing.

# Google OAuth (Google Cloud Console -> OAuth 2.0 Client IDs, "Web application").
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/auth/oauth/google/callback

# Twilio (SMS OTP delivery for phone auth). In non-production environments,
# phone OTPs are logged instead of sent (clearly labeled) when these are unset.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Market data. Outside production, prices are simulated by a dev fixture
# (clearly labeled, never mistakable for real data) unless you opt into a
# real provider below. In production, an unset MARKET_DATA_PROVIDER means
# price endpoints fail loudly ("not configured") rather than ever
# fabricating a price.
# MARKET_DATA_PROVIDER=coingecko
# COINGECKO_API_KEY=

# ---- apps/web -----------------------------------------------------------
# Public (browser-visible) base URL of the API. Never put secrets in a
# NEXT_PUBLIC_* variable — anything prefixed this way ships to the client.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- dev-only seed script (apps/api/src/database/seed/seed-dev-admin.ts) ---
# Never set ALLOW_DEV_SEED=true in production — the script itself also
# refuses to run when NODE_ENV=production, regardless of this flag.
# ALLOW_DEV_SEED=true
# DEV_ADMIN_EMAIL=admin@example.com
# DEV_ADMIN_PASSWORD=
